{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "people/**/*.ts",
    "admissions/**/*.ts",
    "student-lifecycle/**/*.ts",
    "academics/src/**/*.ts",
    "scheduling/src/**/*.ts",
    "attendance/src/**/*.ts",
    "gradebook/src/**/*.ts",
    "records/src/**/*.ts",
    "hr/src/**/*.ts",
    "procurement/src/**/*.ts",
    "inventory-assets/src/**/*.ts",
    "library/src/**/*.ts",
    "transport/src/**/*.ts",
    "residential-catering/src/**/*.ts",
    "activities-trips/src/**/*.ts",
    "billing/src/**/*.ts",
    "ledger/src/**/*.ts"
  ],
  "references": [{ "path": "../events/tsconfig.json" }, { "path": "../policy/tsconfig.json" }]
}
