{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "international-school-platform-web",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "staging": {
      "name": "international-school-platform-web-staging",
      "workers_dev": true,
    },
    "production": {
      "name": "international-school-platform-web-production",
      "workers_dev": true,
    },
  },
}
