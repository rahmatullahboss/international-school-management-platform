{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "international-school-platform-api",
  "main": "src/entry.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "development",
    "APP_REGION": "local",
  },
  "env": {
    "staging": {
      "name": "international-school-platform-api-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "APP_REGION": "global",
        "RUNTIME_PROJECTION_WORKER_ID": "projection-worker-staging-01",
        "RUNTIME_PROJECTION_WORKER_BATCH_SIZE": "20",
        "RUNTIME_PROJECTION_WORKER_MAX_ATTEMPTS": "5",
      },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
    },
  },
}