{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "international-school-platform-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "development",
    "APP_REGION": "local",
  },
}
