{
  "name": "international-school-management-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/modules/*"
  ],
  "scripts": {
    "build": "tsc -b --force && npm run build --workspace=@school/platform-api && npm run build --workspace=@school/platform-web",
    "check:experience-budget": "node scripts/check-experience-build-budget.mjs",
    "check:boundaries": "node scripts/check-architecture-boundaries.mjs",
    "clean": "npm run clean --workspaces --if-present",
    "dev": "npm run dev --workspace=@school/platform-api",
    "format": "prettier --write .",
    "format:check": "prettier --check . || (prettier --write apps/web-student/src/features/experience/StudentPublishedRecordsWorkspace.tsx && git diff -- apps/web-student/src/features/experience/StudentPublishedRecordsWorkspace.tsx && exit 1)",
    "licenses:check": "node scripts/check-licenses.mjs",
    "lint": "eslint . --max-warnings=0",
    "provenance:generate": "node scripts/generate-provenance.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit packages apps",
    "test:integration": "vitest run tests/integration tests/integrations",
    "test:neon": "vitest run tests/integration/neon-direct.test.ts",
    "test:browser:platform": "playwright test -c playwright.config.mjs",
    "test:browser:sis": "tsc -p tests/sis/tsconfig.ui-build.json && playwright test -c tests/sis/playwright.config.mjs",
    "test:browser:finance": "playwright test -c tests/finance/playwright.config.ts",
    "test:browser:integrations": "npm run test:browser --workspace=@school/integrations",
    "test:browser:student-support": "playwright test -c tests/student-support/playwright.config.ts",
    "test:browser:experience": "playwright test -c tests/experience/playwright.config.ts",
    "test:browser": "npm run test:browser:platform && npm run test:browser:sis && npm run test:browser:finance && npm run test:browser:integrations && npm run test:browser:student-support && npm run test:browser:experience",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "typecheck": "tsc -b",
    "validate:artifacts": "python3 scripts/validate_execution_artifacts.py",
    "verify:migrations": "bash tests/integration/verify-wave2-migrations.sh",
    "verify:auth-migrations": "bash tests/integration/verify-auth-durable-context.sh",
    "verify:persona-e2e": "bash tests/integration/verify-product-persona-e2e.sh",
    "verify": "npm run format:check && npm run lint && npm run check:boundaries && npm run typecheck && npm run test && npm run build && npm run check:experience-budget && npm run validate:artifacts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
